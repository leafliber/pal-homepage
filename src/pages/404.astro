---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---
<Base title="页面未找到 — Pal AI Lab" noindex>
  <Header />
  <main id="main" class="not-found container">
    <p class="eyebrow">404</p>
    <h1>页面未找到。</h1>
    <p>该页面可能已移动，或链接地址有误。请返回首页查找相关内容。</p>
    <a class="button button-primary" href="/">返回首页 <span aria-hidden="true">↗</span></a>
  </main>
</Base>
