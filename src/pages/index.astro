---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import LivingCore from '../components/LivingCore.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
const [cortico, coopanion, cortina] = projects;
---
<Base>
  <div class="header-marker" aria-hidden="true"></div>
  <Header />
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span>让 AI 走出聊天框，</span>
          <span>成为身边的<span class="accent">伙伴</span>。</span>
        </h1>
        <p class="hero-description">
          持续运行的智能体，住在桌面的伙伴。<br />
          我们用开源，让 AI 更接近日常。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">探索项目 <span aria-hidden="true">↗</span></a>
          <a class="quiet-link" href={site.github} target="_blank" rel="noopener noreferrer">
            访问 GitHub <span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span>
          </a>
        </div>
      </div>
      <div class="hero-visual"><LivingCore /></div>
    </section>

    <section id="projects" class="projects-section container" aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title">三个项目，一起走近日常。</h2>
        <p>从智能体的底层，到陪伴你的每一天。</p>
      </div>
      <article id="cortico" class="project-feature">
        <div class="project-copy">
          <h3>{cortico.name}</h3>
          <p class="project-tagline">{cortico.tagline}</p>
          <p class="project-description">{cortico.description}</p>
          <a class="text-link" href={cortico.href} target="_blank" rel="noopener noreferrer">
            {cortico.linkLabel}<span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span>
          </a>
        </div>
        <div class="cortico-visual" aria-hidden="true">
          {cortico.image && <img src={cortico.image.src} width={cortico.image.width} height={cortico.image.height} alt="" loading="lazy" />}
        </div>
      </article>
      <div class="project-pair">
        <article id="coopanion" class="project-secondary">
          <div class="project-heading">
            <h3>{coopanion.name}</h3>
            {coopanion.image && <img class="coo-image" src={coopanion.image.src} width={coopanion.image.width} height={coopanion.image.height} alt={coopanion.image.alt} loading="lazy" />}
          </div>
          <p class="project-tagline">{coopanion.tagline}</p>
          <p class="project-description">{coopanion.description}</p>
          <a class="text-link" href={coopanion.href} target="_blank" rel="noopener noreferrer">
            {coopanion.linkLabel}<span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span>
          </a>
        </article>
        <article id="cortina" class="project-secondary">
          <div class="project-heading">
            <h3>{cortina.name}</h3>
            <svg class="code-mark" viewBox="0 0 80 64" width="80" height="64" fill="none" aria-hidden="true"><path d="m24 17-15 15 15 15m32-30 15 15-15 15M46 9 34 55" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
          <p class="project-tagline">{cortina.tagline}</p>
          <p class="project-description">{cortina.description}</p>
          <a class="text-link" href={cortina.href} target="_blank" rel="noopener noreferrer">
            {cortina.linkLabel}<span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span>
          </a>
        </article>
      </div>
    </section>

    <section id="philosophy" class="philosophy-section container" aria-labelledby="philosophy-title">
      <div>
        <p class="section-label">我们的理念</p>
        <h2 id="philosophy-title">技术可以很深。<br />陪伴可以很近。</h2>
      </div>
      <div class="philosophy-copy">
        <p>让智能体持续感知与参与。<br />连接不同环境，让交互回到日常。<br />用开源工具，让想法成为新的能力。</p>
        <a class="button button-primary" href={site.contribute} target="_blank" rel="noopener noreferrer">
          参与构建<span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span>
        </a>
      </div>
    </section>
  </main>
  <footer class="footer container">
    <span>© {new Date().getFullYear()} Pal AI Lab</span>
    <span class="footer-note">让 AI 成为身边的伙伴。</span>
    <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span></a>
  </footer>
  <script>
    // One subtle, finite entrance for project sections; content is visible without JS.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.animate(
            [{ transform: 'translateY(24px)' }, { transform: 'translateY(0)' }],
            { duration: 700, easing: 'cubic-bezier(.2,.65,.3,1)' },
          );
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.12 });
      document.querySelectorAll('.project-feature, .project-secondary, .philosophy-section').forEach((element) => observer.observe(element));
      window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
    }
  </script>
</Base>
