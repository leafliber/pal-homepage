---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PixelText from '../components/PixelText.astro';
import PixelWorld from '../components/PixelWorld.astro';
import TravelerGear from '../components/TravelerGear.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
const chapters = [
  { id: 'home', label: '序章' }, { id: 'projects', label: 'Cortico' },
  { id: 'coopanion', label: 'Coopanion' }, { id: 'cortina', label: 'Cortina' }, { id: 'join', label: '一起共建' },
];
const details = [
  { role: '智能体框架', steps: ['接收事件', '整理上下文', '处理任务'], id:'projects' },
  { role: '桌面伙伴', steps: ['文字聊天', '语音聊天', '经许可操作电脑'], id:'coopanion' },
  { role: '扩展工具', steps: ['描述需求', '编写与测试', '检查安装'], id:'cortina' },
];
---
<Base>
  <div class="world-background" data-world-background aria-hidden="true"><div class="world-grid"></div><div class="background-cross cross-one">+</div><div class="background-cross cross-two">+</div><div class="background-cross cross-three">+</div></div>
  <Header />
  <main id="main" data-journey data-active-scene="0" data-active-group="intro" tabindex="-1">
    <div class="journey-traveler" data-traveler aria-hidden="true">
      <svg class="traveler-sprite" viewBox="0 0 144 156" fill="none" shape-rendering="crispEdges">
        <g class="traveler-shell">
          <path d="M30 6h72v6h18v12h12v18h6v78h-12v12h-12v18H96v-12H42v12H24v-18H12v-12H6V42h6V24h18Z" fill="#242522" />
          <path d="M30 0h72v6h18v12h12v18h6v84h-6v12h-12v24H96v-18H42v18H18v-24H6v-12H0V36h6V18h12V6h12Zm6 6v6H24v12H12v18H6v72h6v12h12v24h12v-18h66v18h12v-24h12v-12h6V42h-6V24h-12V12H96V6Z" fill="currentColor" />
          <path d="M60 108h18v6H60Z" fill="var(--accent)" />
        </g>
        <g class="traveler-eyes" data-traveler-eyes>
          <path d="M30 48h18v6h6v30h-6v6H30v-6h-6V54h6Zm0 6v30h18V54Zm48-6h18v6h6v30h-6v6H78v-6h-6V54h6Zm0 6v30h18V54Z" fill="currentColor" />
        </g>
        <path class="traveler-smile" d="M114 42h6v12h6v24h-6v12h-6V78h6V54h-6Z" fill="currentColor" />
        <TravelerGear />
      </svg>
      <svg class="traveler-thought" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M12 3h12v4h4v12h-4v4H12v5H8v-5H4V7h8Z" fill="var(--accent)"/><path d="M12 9h8v4h-4v3m0 2v3" stroke="#242522" stroke-width="2"/></svg>
    </div>
    <section id="home" class="scene hero-scene is-active" data-scene data-scene-group="intro" aria-labelledby="hero-title">
      <div class="scene-inner">
        <div class="scene-copy hero-copy">
          <h1 id="hero-title" tabindex="-1">做最好的<br /><span class="accent">开源人格 AI。</span></h1>
          <p class="scene-description"><span class="hero-motto" lang="en">Bring your AI to the world!</span>把最新的 AI 技术，变成你身边触手可及的伙伴。</p>
          <div class="scene-actions">
            <a class="button button-primary" href="#projects" data-scene-link><span class="pixel-play" aria-hidden="true"></span>了解开源项目<span aria-hidden="true">↓</span></a>
            <a class="quiet-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span></a>
          </div>
        </div>
        <div class="scene-art hero-art">
          <PixelWorld scene="hero" />
        </div>
      </div>
      <div class="scene-bottom"><a href="#projects" data-scene-link class="scroll-hint"><span class="scroll-mouse" aria-hidden="true"></span> 查看开源项目 <span aria-hidden="true">↓</span></a></div>
    </section>
    {projects.map((project, index) => {
      const detail = details[index]!;
      return <section id={detail.id} class:list={['scene', 'project-scene', `${project.id}-scene`]} data-scene data-scene-group="projects" aria-labelledby={`${project.id}-title`}>
        <div class="scene-inner project-layout">
          <div class="project-panel">
            <div class="project-section-header">
              <p class="project-section-label"><span class="project-section-icon" aria-hidden="true"></span>开源项目</p>
              <nav class="project-switcher" aria-label="项目选择">
                {projects.map((entry, projectIndex) => <a href={`#${details[projectIndex]!.id}`} data-scene-link aria-current={projectIndex === index ? 'step' : undefined}>{entry.name}</a>)}
              </nav>
            </div>
            <div class="project-body">
              <div class="scene-art">
                <PixelWorld scene={project.id} />
              </div>
              <div class="scene-copy">
                <p class="project-role">{detail.role}</p>
                <h2 class="project-title" id={`${project.id}-title`} tabindex="-1"><span class="sr-only">{project.name}</span><PixelText text={project.name} /></h2>
                <p class="scene-description project-description">{project.description}</p>
                <ol class="capability-path" aria-label={`${project.name} 的能力`}>{detail.steps.map((step) => <li>{step}</li>)}</ol>
                <div class="scene-actions"><a class="button button-primary" href={project.href} target="_blank" rel="noopener noreferrer">{project.linkLabel}<span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span></a></div>
              </div>
            </div>
          </div>
        </div>
        <div class="scene-bottom"><a href={`#${chapters[index+2]!.id}`} data-scene-link class="scroll-hint">{index === 2 ? '参与项目' : `下一个：${projects[index+1]!.name}`}<span aria-hidden="true">↓</span></a></div>
      </section>;
    })}
    <section id="join" class="scene join-scene" data-scene data-scene-group="join" aria-labelledby="join-title">
      <div class="scene-inner">
        <div class="scene-copy">
          <h2 id="join-title" tabindex="-1">欢迎参与<br /><span class="accent">开源协作。</span></h2>
          <p class="scene-description">欢迎通过 GitHub 反馈问题、提出建议，或参与代码、设计与文档的改进，共同完善开源人格 AI。</p>
          <div class="contribution-tags"><span><b aria-hidden="true">&lt;/&gt;</b> 代码</span><span><b aria-hidden="true">✳</b> 设计</span><span><b aria-hidden="true">≡</b> 文档</span><span><b aria-hidden="true">+</b> 想法</span></div>
          <div class="scene-actions"><a class="button button-primary" href={site.contribute} target="_blank" rel="noopener noreferrer">贡献指南<span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span></a><a class="quiet-link" href={site.github} target="_blank" rel="noopener noreferrer">项目仓库<span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span></a></div>
        </div>
        <div class="scene-art"><PixelWorld scene="join" /></div>
      </div>
      <footer class="scene-bottom"><span>© {new Date().getFullYear()} Pal AI Lab</span><a href="#home" data-scene-link class="scroll-hint">回到首页 <span aria-hidden="true">↑</span></a></footer>
    </section>
  </main>
  <div class="journey-bar">
    <nav class="chapter-nav" aria-label="章节导航">
      <a href="#home" data-scene-link data-scene-group-link="intro" aria-current="step"><span class="chapter-dot" aria-hidden="true"></span><span class="chapter-nav-label">简介</span></a>
      <a href="#projects" data-scene-link data-scene-group-link="projects"><span class="chapter-dot" aria-hidden="true"></span><span class="chapter-nav-label">项目</span></a>
      <a href="#join" data-scene-link data-scene-group-link="join"><span class="chapter-dot" aria-hidden="true"></span><span class="chapter-nav-label">共建</span></a>
    </nav>
    <div class="journey-controls"><button class="motion-toggle" data-motion-toggle aria-pressed="false" aria-label="暂停动画"><span class="pause-icon" aria-hidden="true"></span><span class="motion-label" data-motion-label>暂停动画</span></button><span class="control-divider"></span><button class="chapter-button" data-scene-prev aria-label="上一幕" disabled>↑</button><button class="chapter-button" data-scene-next aria-label="下一幕">↓</button></div>
  </div>
  <script>
    import { initPixelJourney } from '../scripts/pixel-journey';
    import { initPixelStory } from '../scripts/pixel-story';
    initPixelJourney();
    initPixelStory();
  </script>
</Base>
