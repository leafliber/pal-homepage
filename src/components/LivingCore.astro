---
// The same portrait is used for the static fallback and the optional 3D scene.
---
<section class="living-core" data-living-core data-core-phase="rest" aria-label="眨眼伙伴交互演示">
  <div class="core-stage" data-core-stage>
    <div class="core-portrait">
      <img class="core-still" src="/images/living-core.webp" width="1200" height="1120" fetchpriority="high" alt="白色圆润的立体面罩，深色面板上是一双绿色长眼睛。" data-core-still />
      <img class="core-closed" src="/images/living-core-blink.webp" width="1200" height="1120" alt="" aria-hidden="true" data-core-closed />
    </div>
    <div class="core-canvas" data-core-canvas aria-hidden="true"></div>
  </div>
  <div class="core-caption">
    <p class="core-description" data-core-description>眨眨眼，打个招呼。</p>
    <div class="core-actions" data-core-controls hidden>
      <button class="core-greet" type="button" data-core-greet>打个招呼 <span aria-hidden="true">↗</span></button>
      <button class="core-pause" type="button" data-core-pause hidden aria-pressed="false" aria-label="暂停核心动画"><svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 2h2v8H3zm4 0h2v8H7z"></path></svg><span>暂停</span></button>
    </div>
    <p class="core-disclaimer">交互演示 · 不运行 AI 模型</p>
  </div>
</section>
<script>
  import { initCore } from '../scripts/core';
  document.querySelectorAll<HTMLElement>('[data-living-core]').forEach(initCore);
</script>
<style>
  .living-core { width: 100%; max-width: 620px; position: relative; color: #f2f0eb; }
  .core-stage { position: relative; width: 100%; aspect-ratio: 600 / 560; isolation: isolate; }
  .core-portrait, .core-still, .core-closed, .core-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .core-still, .core-closed { display: block; object-fit: contain; }
  .core-closed { opacity: 0; pointer-events: none; }
  .core-canvas { pointer-events: none; opacity: 0; }
  .core-canvas :global(canvas) { display: block; width: 100%; height: 100%; }
  .living-core[data-webgl="ready"] .core-canvas { opacity: 1; }
  .living-core[data-webgl="ready"] .core-portrait { visibility: hidden; }
  .core-caption { text-align: center; margin-top: -7px; position: relative; min-height: 94px; display: grid; grid-template-rows: 22px 45px 18px; justify-items: center; }
  .core-description { grid-row: 1; color: #c0c5c0; font-size: 12px; line-height: 1.8; min-height: 1.8em; margin: 0; }
  .core-actions { grid-row: 2; display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 7px; min-height: 38px; }
  .core-actions[hidden], .core-pause[hidden] { display: none; }
  .core-actions button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 38px; border: 0; padding: 6px 8px; background: transparent; font: inherit; font-size: 12px; cursor: pointer; border-radius: 4px; }
  .core-greet { color: #5be4ae; }
  .core-greet span { font-size: 16px; transition: transform 180ms ease; }
  .core-greet:hover span { transform: translate(2px, -2px); }
  .core-pause { color: #a6ada7; }
  .core-pause:hover, .core-greet:hover { color: #f4f4eb; }
  .core-disclaimer { grid-row: 3; margin: 3px 0 0; color: #969e96; font-size: 10px; line-height: 1.8; }
  button:focus-visible { outline: 2px solid #5be4ae; outline-offset: 3px; }
  .living-core:not([data-webgl="ready"])[data-core-phase="greet"] .core-portrait { animation: core-greeting 1.4s ease-in-out both; }
  .living-core:not([data-webgl="ready"])[data-core-phase="greet"] .core-still { animation: core-eyes-open 1.4s step-end both; }
  .living-core:not([data-webgl="ready"])[data-core-phase="greet"] .core-closed { animation: core-eyes-closed 1.4s step-end both; }
  .living-core:not([data-webgl="ready"]):is([data-core-paused="true"], [data-core-suspended="true"]) :is(.core-portrait, .core-still, .core-closed) { animation-play-state: paused; }
  @keyframes core-greeting { 0%, 100% { transform: rotate(0); } 40% { transform: rotate(2deg); } 70% { transform: rotate(-.7deg); } }
  @keyframes core-eyes-open { 0%, 23%, 53%, 100% { opacity: 1; } 15%, 45% { opacity: 0; } }
  @keyframes core-eyes-closed { 0%, 23%, 53%, 100% { opacity: 0; } 15%, 45% { opacity: 1; } }
  @media (max-width: 600px) {
    .core-description { font-size: 11px; }
    .core-actions { margin-top: 4px; }
    .core-actions button { min-height: 42px; }
    .core-disclaimer { font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .core-greet span { transition: none; }
    .living-core .core-portrait, .living-core .core-still, .living-core .core-closed { animation: none !important; }
  }
</style>
