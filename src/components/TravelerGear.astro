---
// These four overlays share the traveler's 144 × 156 coordinate system.
// The parent selects one group; the original hero has no visible overlay.
---

<g class="traveler-gear traveler-gear--cortico" data-traveler-gear="cortico">
  <g class="gear-antenna">
    <path d="M66-18h12v30H66Z" fill="currentColor" />
    <path d="M60-30h24v6h6v18h-6v6H60v-6h-6v-18h6Z" fill="var(--accent)" />
    <path class="gear-indicator gear-signal" d="M66-24h12v12H66Z" fill="#242522" />
    <path d="M54 0h36v12H54Z" fill="var(--accent)" />
    <path class="gear-transient gear-radio-pixel gear-radio-pixel--near" d="M42-27h6v6h-6Zm54 0h6v6h-6Z" fill="var(--accent)" opacity="0" />
    <path class="gear-transient gear-radio-pixel gear-radio-pixel--far" d="M30-39h6v6h-6Zm78 0h6v6h-6Z" fill="currentColor" opacity="0" />
  </g>
  <g class="gear-chip">
    <path d="M24 90h6v6h-6Zm18 0h6v6h-6ZM24 126h6v6h-6Zm18 0h6v6h-6ZM12 102h6v6h-6Zm0 12h6v6h-6Zm42-12h6v6h-6Zm0 12h6v6h-6Z" fill="currentColor" />
    <path d="M18 96h36v30H18Z" fill="var(--accent)" />
    <path d="M24 102h24v18H24Z" fill="#242522" />
    <path class="gear-indicator gear-chip-core" d="M30 108h12v6H30Z" fill="currentColor" />
  </g>
</g>

<g class="traveler-gear traveler-gear--coopanion" data-traveler-gear="coopanion">
  <g class="gear-headset">
    <path d="M18-18h108v12h12v18h12v60h-18V12h-12V0H24v12H12v60H-6V12H6V-6h12Z" fill="var(--accent)" />
    <path d="M-12 42h24v54h-24v-6h-6V48h6Zm144 0h18v6h6v42h-6v6h-18Z" fill="currentColor" />
    <path d="M-6 48H6v42H-6Zm144 0h6v42h-6Z" fill="var(--accent)" />
    <path d="M30-12h78v6H30Z" fill="currentColor" />
    <g class="gear-transient gear-listen-bars" fill="var(--accent)" opacity="0">
      <path class="gear-listen-bar gear-listen-bar--one" d="M162 66h3v12h-3Z" />
      <path class="gear-listen-bar gear-listen-bar--two" d="M168 60h3v18h-3Z" />
      <path class="gear-listen-bar gear-listen-bar--three" d="M174 66h3v12h-3Z" />
    </g>
  </g>
  <g class="gear-microphone">
    <path d="M144 90h6v24h-24v-6h18Z" fill="currentColor" />
    <path d="M108 102h12v6h6v6h-6v6h-12v-6h-6v-6h6Z" fill="var(--accent)" />
    <path class="gear-indicator gear-voice" d="M108 108h12v6h-12Z" fill="#242522" />
  </g>
</g>

<g class="traveler-gear traveler-gear--cortina" data-traveler-gear="cortina">
  <g class="gear-helmet">
    <path d="M24-18h30v-12h36v12h30v12h12v18h18v18H-12V12H6V-6h18Z" fill="var(--accent)" />
    <path d="M60-24h18v36H60Z" fill="currentColor" />
    <path d="M24-6h12v18H24Zm78 0h12v18h-12Z" fill="#242522" opacity=".5" />
    <path d="M-6 18h150v6H-6Z" fill="#242522" />
  </g>
  <g class="gear-tool">
    <path d="M144 60h12v18h18V60h12v30h-12v12h-6v42h-18v-42h-6V90h-12V72h12Z" fill="currentColor" />
    <path d="M156 102h6v30h-6Z" fill="#242522" />
    <path d="M126 108h18v6h18v18h-18v-6h-18Z" fill="var(--accent)" />
    <path d="M144 120h12v6h-12Z" fill="#242522" />
    <path class="gear-transient gear-work-spark gear-work-spark--near" d="M162 48h3v6h-3Zm15 6h6v3h-6Z" fill="var(--accent)" opacity="0" />
    <path class="gear-transient gear-work-spark gear-work-spark--far" d="M171 39h3v3h-3Zm15 9h3v3h-3Z" fill="currentColor" opacity="0" />
  </g>
</g>

<g class="traveler-gear traveler-gear--join" data-traveler-gear="join">
  <g class="gear-scarf">
    <path d="M18 96h12v12h18v12h42v-6h18v-6h12V96h12v24h-12v6h-18v6H42v-6H30v-12H18Z" fill="var(--accent)" />
    <path d="M114 102h18v18h-18Z" fill="var(--accent)" />
    <path d="M36 114h6v6h-6Zm12 12h42v6H48Zm72-18h6v6h-6Z" fill="#242522" opacity=".55" />
    <g class="gear-scarf-tail">
      <path d="M120 114h6v12h6v12h-18v-12h6Z" fill="var(--accent)" />
      <path d="M120 114h6v6h-6Zm0 18h6v6h-6Z" fill="#242522" opacity=".55" />
    </g>
  </g>
  <g class="gear-flag">
    <path d="M150 0h6v144h-6Z" fill="currentColor" />
    <g class="gear-flag-fabric">
      <path class="gear-flag-cloth" d="M156 6h36v18h-6v18h-30Z" fill="var(--accent)" />
      <path class="gear-flag-emblem" d="M168 12h6v6h6v6h-6v6h-6v-6h-6v-6h6Z" fill="#242522" />
    </g>
    <path d="M126 108h30v18h-18v-6h-12Z" fill="currentColor" />
    <path d="M138 114h12v6h-12Z" fill="#242522" />
  </g>
</g>
