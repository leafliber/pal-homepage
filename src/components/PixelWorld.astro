---
interface Props {
  scene?: "hero" | "cortico" | "coopanion" | "cortina" | "join";
}

const { scene = "hero" } = Astro.props;
const id = `pixel-${scene}`;
const stars = [
  [77, 117, 1], [181, 68, 0.6], [602, 83, 0.7], [650, 255, 1],
  [109, 353, 0.6], [581, 429, 0.8], [327, 49, 0.5], [467, 88, 0.5],
] as const;
const isHero = scene === "hero";
---

<div class:list={["pixel-world", `pixel-world--${scene}`]} data-pixel-world={scene} aria-hidden="true">
  <svg class="world-canvas" viewBox="0 0 720 540" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id={`${id}-dither`} width="12" height="12" patternUnits="userSpaceOnUse">
        <rect width="3" height="3" fill="currentColor" opacity=".25" />
        <rect x="6" y="6" width="3" height="3" fill="currentColor" opacity=".25" />
      </pattern>
      <pattern id={`${id}-floor`} width="48" height="24" patternUnits="userSpaceOnUse">
        <path d="M0 12 24 0 48 12 24 24Z" stroke="currentColor" stroke-width="1" opacity=".13" />
      </pattern>
      <symbol id={`${id}-star`} viewBox="0 0 20 20">
        <path d="M8 0h4v8h8v4h-8v8H8v-8H0V8h8Z" fill="currentColor" />
      </symbol>
      <symbol id={`${id}-diamond`} viewBox="0 0 30 48">
        <path d="M12 0h6v6h6v12h6v12h-6v12h-6v6h-6v-6H6V30H0V18h6V6h6Z" fill="var(--world-accent)" />
        <path d="M12 6h6v12h-6Zm-6 12h6v12H6Z" fill="var(--world-white)" />
        <path d="M18 24h6v12h-6Zm-6 12h6v6h-6Z" fill="var(--world-dark)" opacity=".35" />
      </symbol>
      <symbol id={`${id}-plant`} viewBox="0 0 60 72">
        <path d="M27 24h6v48h-6Z" fill="var(--world-white)" />
        <path d="M27 18h6V6h6V0h12v18h-6v12H33v12h12V30h15v18h-6v6H33v12h-6V48H15v-6H9V24H0V12h15v6h6v12h6Z" fill="var(--world-accent)" />
        <path d="M33 12h6v12h-6ZM9 18h6v6H9Zm30 30h12v6H39Z" fill="var(--world-white)" opacity=".6" />
      </symbol>
      <symbol id={`${id}-sprout`} viewBox="0 0 36 36">
        <path d="M15 18h6v18h-6ZM3 6h12v6h6v12H9v-6H3Zm18 6V6h6V0h9v12h-6v6h-9Z" fill="var(--world-accent)" />
      </symbol>
      <symbol id={`${id}-mascot`} viewBox="0 0 144 156">
        <path d="M30 6h72v6h18v12h12v18h6v78h-12v12h-12v18H96v-12H42v12H24v-18H12v-12H6V42h6V24h18Z" fill="var(--world-dark)" />
        <path d="M30 0h72v6h18v12h12v18h6v84h-6v12h-12v24H96v-18H42v18H18v-24H6v-12H0V36h6V18h12V6h12Zm6 6v6H24v12H12v18H6v72h6v12h12v24h12v-18h66v18h12v-24h12v-12h6V42h-6V24h-12V12H96V6Z" fill="var(--world-white)" />
        <g class="mascot-eyes">
          <path d="M30 48h18v6h6v30h-6v6H30v-6h-6V54h6Zm0 6v30h18V54Zm48-6h18v6h6v30h-6v6H78v-6h-6V54h6Zm0 6v30h18V54Z" fill="var(--world-white)" />
          <path d="M114 42h6v12h6v24h-6v12h-6V78h6V54h-6Z" fill="var(--world-white)" />
        </g>
        <path d="M60 108h18v6H60Z" fill="var(--world-accent)" />
        <path d="M12 96h6v6h-6Zm6 6h6v6h-6Z" fill="var(--world-white)" opacity=".25" />
      </symbol>
      <symbol id={`${id}-mini-pal`} viewBox="0 0 72 78">
        <path d="M18 0h36v6h12v12h6v42h-6v18H54V66H18v12H6V60H0V18h6V6h12Z" fill="var(--world-white)" />
        <path d="M18 24h6v18h-6Zm24 0h6v18h-6Zm-12 30h12v6H30Z" fill="var(--world-dark)" />
        <path d="M6 48h6v6H6Zm54 0h6v6h-6Z" fill="var(--world-accent)" />
      </symbol>
      <symbol id={`${id}-cube`} viewBox="0 0 60 66">
        <path d="m30 0 30 15v36L30 66 0 51V15Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="3" />
        <path d="m1 15 29 15 29-15M30 30v34" stroke="var(--world-white)" stroke-width="3" />
        <path d="m30 7 17 8-17 9-17-9Z" fill="var(--world-accent)" />
        <path d="M8 28v18l14 7" stroke="var(--world-white)" stroke-width="3" opacity=".3" />
      </symbol>
    </defs>

    <g class="world-stars assembly" style={`--reveal-delay:${isHero ? "6.2s" : ".8s"}`}>
      {stars.map(([x, y, scale], index) => (
        <use href={`#${id}-star`} x={x} y={y} width={20 * scale} height={20 * scale} class="twinkle" style={`--twinkle-delay:${index * -.8}s`} opacity={index % 2 ? ".25" : ".65"} />
      ))}
      <rect x="144" y="221" width="4" height="4" fill="currentColor" opacity=".5" />
      <rect x="611" y="359" width="4" height="4" fill="currentColor" opacity=".4" />
      <rect x="248" y="95" width="4" height="4" fill="currentColor" opacity=".5" />
      <rect x="551" y="179" width="4" height="4" fill="var(--world-accent)" />
    </g>

    <g class="world-ground assembly" style={`--reveal-delay:${isHero ? "3s" : ".1s"}`}>
      <path d="m183 409 169-83 191 83-179 91Z" fill={`url(#${id}-dither)`} opacity=".38" />
      <path d="m186 403 12 6m13 6 12 6m13 6 12 6m13 6 12 6m13 6 12 6m13 6 12 6m13 6 12 6m27 0 12-6m13-6 12-6m13-6 12-6m13-6 12-6m13-6 12-6m13-6 12-6m13-6 12-6" stroke="currentColor" stroke-width="2" opacity=".17" />
    </g>

    <g class="island assembly" data-story-island data-story-part="island" style={`--reveal-delay:${isHero ? "3.1s" : ".2s"}`}>
      <path d="M174 328h18v-12h24v-12h24v-12h24v-12h24v-12h24v-12h24v-12h24v12h24v12h24v12h24v12h24v12h24v12h24v12h24v12h18v48h-18v12h-24v12h-24v12h-24v12h-24v12h-24v12h-24v12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-18Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="2" />
      <path d="m175 329 177 89 192-79v36h-18v12h-24v12h-24v12h-24v12h-24v12h-24v12h-24v12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-18Z" fill={`url(#${id}-dither)`} />
      <path d="M174 328h18v-12h24v-12h24v-12h24v-12h24v-12h24v-12h24v-12h24v12h24v12h24v12h24v12h24v12h24v12h24v12h24v12h18v12h-18v12h-24v12h-24v12h-24v12h-24v12h-24v12h-24v12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-24v-12h-18Z" fill="var(--world-platform)" stroke="var(--world-white)" stroke-width="2" />
      <path d="m184 332 172-86 178 91-178 87Z" fill={`url(#${id}-floor)`} />
      <path d="M194 330h18v-12h24v-12h24v-12h24v-12h24v-12h24v-12h18" stroke="var(--world-white)" stroke-width="3" opacity=".4" />
      <path d="M352 427v35m24-48v34m24-45v33m24-45v33m24-45v33m24-45v33m24-45v33m24-45v33" stroke="var(--world-white)" stroke-width="2" opacity=".22" />
      <path d="M215 374h6v6h-6Zm24 12h6v6h-6Zm24 12h6v6h-6Zm24 12h6v6h-6Z" fill="var(--world-accent)" opacity=".8" />
    </g>

    {isHero && (
      <>
        <rect data-traveler-anchor x="290" y="165" width="144" height="156" fill="none" />
        <g class="assembly" style="--reveal-delay:3.2s">
          <path d="m293 324 58-27 70 29-60 29Z" fill="var(--world-dark)" opacity=".8" />
        </g>
        <g class="intro-seed transient story-transient" data-story-seed>
          <path d="M364 268h8v8h-8Z" fill="var(--world-accent)" />
          <path d="M352 258h4v4h-4Zm-9-8h3v3h-3Z" fill="var(--world-white)" opacity=".4" />
        </g>
        <g class="intro-impact transient story-transient" data-story-impact>
          <path d="m413 354 18-9 18 9-18 9Z" stroke="var(--world-accent)" stroke-width="3" />
          <path d="M405 345h4v4h-4Zm48 0h4v4h-4Zm-24-15h4v4h-4Z" fill="var(--world-accent)" />
        </g>
        <g class="assembly grow-in" data-story-growth data-story-part="sprouts" style="--reveal-delay:4.1s">
          <use href={`#${id}-plant`} x="225" y="242" width="48" height="58" />
        </g>
        <g class="assembly grow-in" style="--reveal-delay:4.6s">
          <g class="garden-sprout"><use href={`#${id}-sprout`} x="422" y="343" width="28" height="28" /></g>
          <path d="M278 335h18v6h-18Zm-6 6h30v6h-30Zm36 29h12v6h-12Z" fill="var(--world-white)" opacity=".3" />
        </g>
        <g class="assembly" data-story-pathways style="--reveal-delay:5.2s">
          <path d="M263 137h-71v61h-61v53m323-87h104v81h45v84" stroke="currentColor" stroke-width="2" stroke-dasharray="3 9" opacity=".25" />
          <path d="m83 275 48-24 48 24v18l-48 24-48-24Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="2" />
          <path d="m83 275 48 24 48-24m-48 24v18" stroke="var(--world-white)" stroke-width="2" />
          <use href={`#${id}-cube`} x="111" y="226" width="40" height="44" />
        </g>
        <g class="assembly" style="--reveal-delay:5.6s">
          <path d="m527 165 42-21 42 21v18l-42 21-42-21Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="2" />
          <path d="m527 165 42 21 42-21m-42 21v18" stroke="var(--world-white)" stroke-width="2" />
        </g>
        <g class="assembly" data-story-crystal style="--reveal-delay:6.2s">
          <g class="garden-crystal"><use href={`#${id}-diamond`} x="462" y="274" width="24" height="39" /></g>
          <use href={`#${id}-diamond`} x="558" y="112" width="22" height="35" />
          <path d="M463 256v-6m24 13 6-6m-43 18h-7" stroke="var(--world-accent)" stroke-width="3" class="crystal-rays" />
        </g>
        <g class="assembly friend-arrival" data-story-friend data-story-part="friend" style="--reveal-delay:6.8s">
          <g class="garden-friend"><use href={`#${id}-mini-pal`} x="220" y="317" width="42" height="46" /></g>
        </g>
        <g class="assembly" style="--reveal-delay:7.3s">
          <path class="garden-heart" d="M231 286h6v6h6v-6h6v6h6v6h-6v6h-6v6h-6v-6h-6v-6h-6v-6h6Z" fill="var(--world-accent)" />
        </g>
        <g class="garden-seed transient story-transient" data-story-loop="seed-to-friend">
          <rect x="365" y="271" width="6" height="6" fill="var(--world-accent)" />
        </g>
        <g class="garden-ripple transient story-transient"><path d="m412 355 21-10 21 10-21 10Z" stroke="var(--world-accent)" stroke-width="2" /></g>
        <g class="garden-firefly transient story-transient"><path d="M432 343h5v5h-5Z" fill="var(--world-white)" /></g>
      </>
    )}

    {scene === "cortico" && (
      <>
        <rect data-traveler-anchor x="145" y="267" width="65" height="70" fill="none" />
        <g class="assembly" style="--reveal-delay:.45s">
          <path d="M235 322v-80h60m133 80v-80h-36M353 314v43h90v-33" stroke="var(--world-accent)" stroke-width="3" stroke-dasharray="5 7" opacity=".45" />
          <path d="M302 130h108v12h12v12h12v132h-12v12H290v-12h-12V154h12v-12h12Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="3" />
          <path d="M290 166h132m-132 96h132" stroke="var(--world-white)" stroke-width="2" opacity=".3" />
          <g class="engine-awake" data-story-engine>
            <path d="M335 187h42v12h12v36h-12v12h-42v-12h-12v-36h12Z" stroke="var(--world-accent)" stroke-width="4" />
            <path d="M344 205h24v24h-24Z" fill="var(--world-accent)" />
            <path d="M306 208h9m83 0h9m-101 18h9m83 0h9m-61-49v-7m20 7v-7m-20 85v-7m20 7v-7" stroke="var(--world-white)" stroke-width="3" opacity=".4" />
          </g>
          <rect x="301" y="148" width="5" height="5" fill="var(--world-accent)" />
          <rect x="313" y="148" width="5" height="5" fill="var(--world-white)" opacity=".4" />
          <rect x="325" y="148" width="5" height="5" fill="var(--world-white)" opacity=".4" />
          <path d="M304 279h38m12 0h10m10 0h32" stroke="var(--world-accent)" stroke-width="4" class="engine-status" />
        </g>
        <g class="assembly" style="--reveal-delay:.9s">
          <use href={`#${id}-cube`} x="209" y="284" width="48" height="53" />
          <use href={`#${id}-cube`} x="425" y="296" width="48" height="53" />
        </g>
        <g class="assembly grow-in" style="--reveal-delay:4.4s">
          <g class="engine-growth" data-story-response><use href={`#${id}-sprout`} x="342" y="348" width="30" height="30" /></g>
        </g>
        <g class="engine-input transient story-transient" data-story-signal><rect x="232" y="304" width="7" height="7" fill="var(--world-white)" /></g>
        <g class="engine-output transient story-transient"><rect x="391" y="239" width="7" height="7" fill="var(--world-accent)" /></g>
        <g class="engine-response transient story-transient"><path d="M445 283h5v5h-5Zm12-8h4v4h-4Zm-24 0h4v4h-4Z" fill="var(--world-accent)" /></g>
      </>
    )}

    {scene === "coopanion" && (
      <>
        <rect data-traveler-anchor x="458" y="316" width="66" height="72" fill="none" />
        <g class="assembly" style="--reveal-delay:.45s">
          <path d="M214 149h280v169H214Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="3" />
          <path d="M214 174h280" stroke="var(--world-white)" stroke-width="2" />
          <path d="M336 320v24h-42v12h123v-12h-42v-24" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="3" />
          <rect x="226" y="160" width="4" height="4" fill="var(--world-accent)" />
          <rect x="237" y="160" width="4" height="4" fill="var(--world-white)" opacity=".4" />
          <rect x="248" y="160" width="4" height="4" fill="var(--world-white)" opacity=".4" />
          <path d="M234 202h93m-93 12h56m-56 12h71" stroke="currentColor" stroke-width="4" opacity=".2" />
          <path d="M234 283h235m-235 14h110" stroke="currentColor" stroke-width="2" opacity=".12" />
          <path class="desktop-cursor" d="M429 204v33l8-8 7 13 7-4-7-12h13Z" fill="var(--world-white)" />
        </g>
        <g class="assembly friend-arrival" style="--reveal-delay:1.25s" data-story-meeting>
          <g class="desktop-friend"><use href={`#${id}-mini-pal`} x="337" y="227" width="72" height="78" /></g>
        </g>
        <g class="assembly" style="--reveal-delay:2.4s">
          <g class="desktop-greeting" data-story-heart>
            <path d="M376 94h60v6h6v42h-6v6h-36v12h-12v-12h-12v-6h-6v-42h6Z" fill="var(--world-accent)" />
            <path d="M389 111h6v6h6v-6h6v6h6v6h-6v6h-6v6h-6v-6h-6v-6h-6v-6h6Z" fill="var(--world-dark)" />
          </g>
        </g>
        <g class="assembly" style="--reveal-delay:.9s">
          <use href={`#${id}-plant`} x="442" y="302" width="32" height="39" />
          <path d="M241 338h24v6h6v18h-6v6h-24v-6h-6v-18h6Z" fill="var(--world-white)" />
          <path d="M271 344h12v12h-12" stroke="var(--world-white)" stroke-width="4" />
          <path class="steam" d="M245 328v-14h6v-12m9 26v-10h6v-12" stroke="var(--world-white)" stroke-width="3" opacity=".3" />
        </g>
        <g class="desktop-reply transient story-transient"><path d="M480 284h5v5h5v-5h5v5h5v5h-5v5h-5v5h-5v-5h-5v-5h-5v-5h5Z" fill="var(--world-accent)" /></g>
      </>
    )}

    {scene === "cortina" && (
      <>
        <rect data-traveler-anchor x="162" y="298" width="65" height="70" fill="none" />
        <g class="assembly" style="--reveal-delay:.45s">
          <path d="M267 165h174v155H267Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="3" />
          <path d="M282 151h144v14H282Zm0 169h144v14H282Z" fill="var(--world-white)" />
          <path d="M296 198h117m-117 14h69m-69 14h96m-96 14h54" stroke="var(--world-white)" stroke-width="4" opacity=".25" />
          <path d="m315 264-12 12 12 12m25-24 12 12-12 12m-9-29-8 34" stroke="var(--world-accent)" stroke-width="4" />
          <path d="M369 284h37" stroke="var(--world-accent)" stroke-width="5" class="builder-cursor" />
        </g>
        <g class="assembly" style="--reveal-delay:1s">
          <g class="builder-crystal"><use href={`#${id}-diamond`} x="220" y="223" width="24" height="39" /></g>
        </g>
        <g class="builder-signal transient story-transient" data-story-build-signal><rect x="229" y="239" width="7" height="7" fill="var(--world-accent)" /></g>
        <g class="assembly build-in" style="--reveal-delay:2.7s"><use href={`#${id}-cube`} x="430" y="288" width="60" height="66" /></g>
        <g class="assembly build-in" style="--reveal-delay:3.2s"><use href={`#${id}-cube`} x="430" y="224" width="60" height="66" /></g>
        <g data-story-bridge>
          <g class="assembly build-in" style="--reveal-delay:3.7s"><g class="bridge-step bridge-step--one"><path d="m267 354 24-12 24 12v12l-24 12-24-12Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="2" /><path d="m267 354 24 12 24-12m-24 12v12" stroke="var(--world-accent)" stroke-width="2" /></g></g>
          <g class="assembly build-in" style="--reveal-delay:4.2s"><g class="bridge-step bridge-step--two"><path d="m315 365 24-12 24 12v12l-24 12-24-12Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="2" /><path d="m315 365 24 12 24-12m-24 12v12" stroke="var(--world-accent)" stroke-width="2" /></g></g>
          <g class="assembly build-in" style="--reveal-delay:4.7s"><g class="bridge-step bridge-step--three"><path d="m363 352 24-12 24 12v12l-24 12-24-12Z" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="2" /><path d="m363 352 24 12 24-12m-24 12v12" stroke="var(--world-accent)" stroke-width="2" /></g></g>
        </g>
        <g class="builder-done transient story-transient"><path d="M455 202v-12m-6 6h12m-49 148v-8m-4 4h8" stroke="var(--world-accent)" stroke-width="3" /></g>
      </>
    )}

    {scene === "join" && (
      <>
        <rect data-traveler-anchor x="421" y="291" width="72" height="78" fill="none" />
        <g class="assembly" style="--reveal-delay:.45s">
          <path d="M315 290V137h12v-24h12v-12h72v12h12v24h12v153" fill="var(--world-dark)" stroke="var(--world-white)" stroke-width="3" />
          <path d="m308 292 59 29 78-38-22-10-56 26-38-18Z" fill="var(--world-white)" />
          <path d="m367 321 78-38v12l-78 38-59-29v-12Z" fill="var(--world-white)" opacity=".4" />
        </g>
        <g class="assembly friend-arrival" style="--reveal-delay:1s" data-story-gathering>
          <g class="join-friend join-friend--one"><use href={`#${id}-mini-pal`} x="235" y="267" width="60" height="65" /></g>
        </g>
        <g class="assembly friend-arrival" style="--reveal-delay:1.7s">
          <g class="join-friend join-friend--two"><use href={`#${id}-mini-pal`} x="296" y="334" width="38" height="42" /></g>
        </g>
        <g class="assembly" style="--reveal-delay:2.7s" data-story-portal>
          <path class="portal-rim" d="M331 285V142h12v-24h60v24h12v143" stroke="var(--world-accent)" stroke-width="4" />
          <path d="M347 273V151h12v-17h30v17h12v122" fill="var(--world-accent)" opacity=".09" />
          <path class="portal-light" d="M353 263V154h12v-14h18v14h12v109" fill="var(--world-accent)" opacity=".08" />
        </g>
        <g class="assembly" style="--reveal-delay:3.4s">
          <path d="M360 185h6v6h6v-6h6v6h6v6h-6v6h-6v6h-6v-6h-6v-6h-6v-6h6Z" fill="var(--world-accent)" class="join-heart" />
        </g>
        <g class="assembly grow-in" style="--reveal-delay:1.2s">
          <use href={`#${id}-sprout`} x="355" y="347" width="28" height="28" />
          <use href={`#${id}-plant`} x="241" y="214" width="36" height="43" />
        </g>
        <g class="portal-sparks transient story-transient"><path d="M350 231h6v6h-6Zm32 23h6v6h-6Zm-13-94h4v4h-4Zm22 45h4v4h-4Z" fill="var(--world-accent)" /></g>
