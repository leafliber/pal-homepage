---
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/story.css';
import '../styles/sections.css';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#242522" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {site.url && <><meta property="og:url" content={canonical} /><meta property="og:image" content={`${site.url}/images/og.png`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Pal AI Lab：做最好的开源人格 AI。Bring your AI to the world!" /><meta name="twitter:card" content="summary_large_image" /></>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <slot />
  </body>
</html>
